# ─────────────────────────────────────────────────────────────────────────────
# Customer Assistant — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development        # development | staging | production | test
APP_NAME=customer-assistant
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# SECRET_KEY is auto-generated on startup if not set.
# Set explicitly in production and store in Secrets Manager.
# SECRET_KEY=<32-byte-hex>

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_QUERY_TIMEOUT=30

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=100

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for live LLM functionality. Tests use mocks.
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=60.0

# ── OCR ───────────────────────────────────────────────────────────────────────
# tesseract (local dev, no AWS needed) | textract (production)
OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract
TEXTRACT_REGION=us-east-1
OCR_CONFIDENCE_THRESHOLD=60.0

# ── Storage ───────────────────────────────────────────────────────────────────
# local (dev) | s3 (production)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/documents
LOCAL_ARTIFACTS_PATH=./data/artifacts

# S3 (required when STORAGE_BACKEND=s3)
# AWS credentials should come from IAM role in production, not env vars.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_DOCUMENTS_BUCKET=customer-assistant-documents
S3_ARTIFACTS_BUCKET=customer-assistant-artifacts
SQS_INGESTION_QUEUE_URL=
SQS_DLQ_URL=

# ── Authentication / JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RETRIEVAL_RERANK_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.0
RETRIEVAL_LEXICAL_WEIGHT=0.4
RETRIEVAL_DENSE_WEIGHT=0.6

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
TABLE_CHUNK_MAX_ROWS=50

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=20
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=120.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=200

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
MAX_PAGES_PER_DOCUMENT=2000

# ── Token budgets ─────────────────────────────────────────────────────────────
MAX_CONTEXT_TOKENS=100000
MAX_COMPLETION_TOKENS=4096

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_ENDPOINT=                  # e.g. http://otel-collector:4317 (optional)
OTEL_SERVICE_NAME=customer-assistant

# LangSmith (optional — only needed for LLM tracing)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=customer-assistant
LANGSMITH_TRACING=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]
